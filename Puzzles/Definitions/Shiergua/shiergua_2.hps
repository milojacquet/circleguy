add_puzzle(
    name = "Shiergua-2",
    authors = ["Milo Jacquet"],
    scramble = 1500,
    build = fn() {
        r = sqrt(16 - 9*sqrt(3))
        pr = point(0.5, 0)
        pl = point(-0.5, 0)
        cr = circle(pr, r)
        cl = circle(pl, r)
        tr = turn(cr, 12)
        tl = turn(cl, 12)
        add_circles([cr, cl])
        add_turns([tr, tl], ["R", "L"])
        for sym in turn(circle(0, 0, 5), 2).powers() {
            turn(sym)
            for trpow in tr.mult(2).powers() {
                turn(trpow)
                cut([tl])
                cut([tr, tl])
                cut([cr], [tl, tr])
                cut([cr], [tl.mult(-1), tr])
                undo()
            }
            undo_all()
        }
        color([cl, ~cr], red)
        color([cl, cr], blue)
        color([~cl, cr], green)
    },
)